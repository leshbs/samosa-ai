# ─── Supabase ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI provider ───────────────────────────
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ─── Google OAuth ───────────────────────────
# dari Google Cloud Console. Client ID & Secret didaftarkan di Supabase
# Dashboard (Authentication → Providers → Google) — Supabase yang menangani
# OAuth flow-nya, bukan app code ini. Disimpan di sini untuk dokumentasi tim.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Background worker ─────────────────────
# Shared secret for POST /api/webhooks/inngest (>= 16 chars)
WORKER_SECRET=change-me-to-a-long-random-string

# ─── Monitoring ────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# ─── App ───────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
