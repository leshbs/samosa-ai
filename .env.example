# ─── Supabase ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI provider ───────────────────────────
OPENAI_API_KEY=sk-xxxxxxxx
# gpt-4o / gpt-4.1 family only: gpt-5 and o-series reject the adapter's
# max_tokens and temperature 0. Paste without quotes.
OPENAI_MODEL=gpt-4o-mini

# ─── Google OAuth ───────────────────────────
# dari Google Cloud Console. Client ID & Secret didaftarkan di Supabase
# Dashboard (Authentication → Providers → Google) — Supabase yang menangani
# OAuth flow-nya, bukan app code ini. Disimpan di sini untuk dokumentasi tim.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Background worker ─────────────────────
# Shared secret for POST /api/webhooks/inngest (>= 16 chars)
WORKER_SECRET=change-me-to-a-long-random-string

# Vercel Cron sends this as `Authorization: Bearer <value>` to
# GET /api/cron/sweep-jobs, which fails stuck analysis jobs once a day.
# Unset means the endpoint refuses every request — the sweeper is then off.
CRON_SECRET=change-me-to-a-long-random-string

# ─── Monitoring ────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# ─── App ───────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signup verification and password-reset emails. Leave unset (off) until SMTP
# is set up, and keep Supabase's "Confirm email" switch matching it:
# off here = Confirm email OFF in Supabase. See docs/auth-setup.md.
NEXT_PUBLIC_EMAIL_LINKS_ENABLED=
